---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
---

<Layout title="404: Not Found - Ferro Security">
    <Navbar />
    <main class="relative min-h-screen flex items-center justify-center overflow-hidden bg-bg-page pt-20 pb-20">
        <!-- Background Glow Effects -->
        <div class="absolute inset-0 z-0 pointer-events-none hidden md:block">
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-primary/10 rounded-full blur-[120px] mix-blend-screen"></div>
            <div class="absolute top-1/4 left-1/4 w-[400px] h-[400px] bg-brand-accent/10 rounded-full blur-[80px] mix-blend-screen"></div>
        </div>

        <div class="container mx-auto px-6 relative z-10 text-center">
            <!-- 404 Text -->
            <div class="relative inline-block mb-4 group">
                <h1 class="text-9xl md:text-[12rem] font-extrabold tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-text-main/80 to-transparent select-none drop-shadow-2xl opacity-90 transition-all duration-700">
                    404
                </h1>
                <div class="absolute inset-0 bg-brand-primary/20 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-700 -z-10"></div>
            </div>
            
            <div class="max-w-xl mx-auto backdrop-blur-md bg-white/5 border border-white/10 rounded-3xl p-8 md:p-12 shadow-[0_0_40px_rgba(0,0,0,0.3)] hover:border-brand-primary/30 transition-colors duration-500">
                <div class="mb-6 flex justify-center">
                    <div class="w-16 h-16 rounded-full bg-bg-surface flex items-center justify-center border border-white/10 shadow-inner relative overflow-hidden group">
                        <div class="absolute inset-0 bg-brand-accent/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
                        <svg class="w-8 h-8 text-brand-primary relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                </div>

                <h2 class="text-3xl md:text-4xl font-bold text-text-main mb-4 tracking-tight">Connection Lost</h2>
                <p class="text-text-muted text-lg mb-10 leading-relaxed max-w-md mx-auto">
                    The secure tunnel you are trying to access has been closed or the destination does not exist.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="/" class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-brand-primary hover:bg-brand-secondary text-white font-bold text-lg transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-brand-primary/40 group w-full sm:w-auto relative overflow-hidden">
                        <span class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></span>
                        <svg class="w-5 h-5 mr-3 group-hover:-translate-x-1 transition-transform relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        <span class="relative z-10">Return to Homepage</span>
                    </a>
                    
                    <a href="/support" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-bg-surface hover:bg-bg-surface-secondary border border-border-main text-text-main font-semibold transition-all backdrop-blur-sm hover:border-brand-primary/50 flex items-center justify-center group">
                        <svg class="w-5 h-5 mr-2 text-brand-primary group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        Support
                    </a>
                </div>
            </div>
            
            <!-- Tech-noir subtle details -->
            <div class="mt-16 flex flex-col items-center justify-center space-y-2 font-mono text-xs text-text-muted/50 select-none">
                <p class="tracking-widest">SYSTEM_STATUS: <span class="text-brand-accent/80">OFFLINE</span></p>
                <div class="flex items-center gap-2 mt-2">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                    </span>
                    <span class="tracking-widest">ERR_SECURE_TUNNEL_404</span>
                </div>
            </div>
        </div>
    </main>
    <Footer />
</Layout>
